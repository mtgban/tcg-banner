{
  "manifest_version": 3,
  "name": "tcg-banner",
  "version": "0.1.0",
  "description": "Export a TCGplayer order history as CSV, search an order by its number, and send an order to BAN.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tcg-banner@mtgban.com",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.tcgplayer.com/myaccount/orderhistory*"
      ],
      "js": [
        "src/money.js",
        "src/csv.js",
        "src/read.js",
        "src/net.js",
        "src/walk.js",
        "src/handoff.js",
        "src/ui.js",
        "src/page.js"
      ],
      "css": [
        "src/panel.css",
        "src/orders.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
